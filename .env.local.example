# --- LINE (customer-facing Official Account for this store) ---
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
NEXT_PUBLIC_LIFF_ID=

# Stable LINE OA identifier (the "@xxxxxxx" Bot basic ID from the LINE
# Developers console — Basic settings tab). Used to look up the
# `stores` record dynamically, so no generated PocketBase ID needs to
# be copied by hand. Set the SAME value on both lines.
NEXT_PUBLIC_LINE_OA_ID=@yourbotid
LINE_OA_ID=@yourbotid

# --- PocketBase ---
NEXT_PUBLIC_POCKETBASE_URL=https://mobile.wellna.jp
POCKETBASE_URL=https://mobile.wellna.jp
POCKETBASE_ADMIN_EMAIL=
POCKETBASE_ADMIN_PASSWORD=

# --- Seed script only (npm run seed) ---
# Same LINE credentials as above, reused to populate the stores row.
# --- Seed script only (npm run seed) ---
# Must match NEXT_PUBLIC_LINE_OA_ID / LINE_OA_ID above exactly — the
# app looks up the store by this value, so if it doesn't match what's
# on the created record, every query returns 404.
STORE_LINE_OA_ID=@yourbotid
STORE_LINE_CHANNEL_SECRET=
STORE_LINE_CHANNEL_ACCESS_TOKEN=
STORE_LIFF_ID=
STORE_NAME=はるみ鉄板 心斎橋店
STORE_NAME_EN=Harumi Teppan (Shinsaibashi)
STORE_ADDRESS=
