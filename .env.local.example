# --- LINE (customer-facing Official Account for this store) ---
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
NEXT_PUBLIC_LIFF_ID=

# Stable LINE OA identifier (the "@xxxxxxx" Bot basic ID from the LINE
# Developers console — Basic settings tab). The app resolves the
# `stores` record by this value (via /api/store server-side), so no
# generated PocketBase ID needs to be copied by hand. This is the only
# one the running app actually reads at runtime — NEXT_PUBLIC_LINE_OA_ID
# does NOT need to be set for the app itself; it's kept below only for
# scripts/debug-store.mjs to compare against.
LINE_OA_ID=@yourbotid

# --- PocketBase ---
# NEXT_PUBLIC_POCKETBASE_URL is used by the browser for the public
# menu_categories/menu_items reads (see README's "Architecture" section
# on which collections are public vs admin-only). POCKETBASE_URL is
# used server-side (webhook, seed script, admin-authenticated routes).
# Keep both pointed at the same instance.
NEXT_PUBLIC_POCKETBASE_URL=https://mobile.wellna.jp
POCKETBASE_URL=https://mobile.wellna.jp
POCKETBASE_ADMIN_EMAIL=
POCKETBASE_ADMIN_PASSWORD=

# --- Seed script + debug script only (npm run seed / debug-store.mjs) ---
# STORE_LINE_OA_ID must match LINE_OA_ID above exactly — the seed
# script writes this onto the stores record, and the app looks the
# record up by LINE_OA_ID. If they don't match character-for-character,
# every store/menu query 404s.
STORE_LINE_OA_ID=@yourbotid
STORE_LINE_CHANNEL_SECRET=
STORE_LINE_CHANNEL_ACCESS_TOKEN=
STORE_LIFF_ID=
STORE_NAME=はるみ鉄板 心斎橋店
STORE_NAME_EN=Harumi Teppan (Shinsaibashi)
STORE_ADDRESS=

# Only read by scripts/debug-store.mjs, for comparing against what's
# actually stored in PocketBase. Not used by the running app.
NEXT_PUBLIC_LINE_OA_ID=@yourbotid
