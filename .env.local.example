# --- LINE (customer-facing Official Account for this store) ---
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
NEXT_PUBLIC_LIFF_ID=

# Stable LINE OA identifier (the "@xxxxxxx" Bot basic ID from the LINE
# Developers console — Basic settings tab). The app resolves the
# `stores` record by this value (via /api/store server-side), so no
# generated PocketBase ID needs to be copied by hand. This is the only
# one the running app actually reads at runtime — NEXT_PUBLIC_LINE_OA_ID
# does NOT need to be set for the app itself; it's kept below only for
# scripts/debug-store.mjs to compare against.
LINE_OA_ID=@yourbotid

# --- Staff order dashboard (/staff/orders and /staff/liff/orders) ---
# Two independent access methods — both read the same
# /api/staff/orders endpoints, see src/lib/staff-auth.ts.
#
# 1. Shared tablet/passcode (/staff/orders): single passcode, no
#    per-person identity. Fails closed if unset.
STAFF_ACCESS_CODE=

# 2. Personal LINE access (/staff/liff/orders): requires a SECOND LIFF
#    app registered under the same LINE channel as the customer one
#    (LINE Developers console -> your channel -> LIFF -> Add), pointed
#    at /staff/liff/orders, with "ID token" turned ON (this is what
#    makes verifyLineIdToken in lib/line.ts work — without it,
#    liff.getIDToken() returns null and staff can't log in this way).
NEXT_PUBLIC_STAFF_LIFF_ID=
# The channel ID (numeric) from that same console page's Basic
# settings tab — used as the `client_id` when verifying ID tokens.
# This is the underlying Messaging API channel's ID, same for both
# the customer and staff LIFF apps since they're two LIFF apps on one
# channel ("same OA" setup).
LINE_CHANNEL_ID=

# Only needed if you run `npm run setup-staff-rich-menu` /
# `npm run add-staff` (see those scripts' comments) — same value as
# STORE_LINE_CHANNEL_ACCESS_TOKEN below, duplicated here because these
# are separate one-off scripts, not the running app.
STAFF_LINE_CHANNEL_ACCESS_TOKEN=
# Both printed by `npm run setup-staff-rich-menu` — paste them back
# here so `npm run add-staff` knows which menu to link, based on the
# role you pass it (staff -> 2-panel menu, admin -> 3-panel menu with
# reports added).
STAFF_RICH_MENU_ID=
ADMIN_RICH_MENU_ID=


# NEXT_PUBLIC_POCKETBASE_URL is used by the browser for the public
# menu_categories/menu_items reads (see README's "Architecture" section
# on which collections are public vs admin-only). POCKETBASE_URL is
# used server-side (webhook, seed script, admin-authenticated routes).
# Keep both pointed at the same instance.
NEXT_PUBLIC_POCKETBASE_URL=https://mobile.wellna.jp
POCKETBASE_URL=https://mobile.wellna.jp
POCKETBASE_ADMIN_EMAIL=
POCKETBASE_ADMIN_PASSWORD=

# --- Seed script + debug script only (npm run seed / debug-store.mjs) ---
# STORE_LINE_OA_ID must match LINE_OA_ID above exactly — the seed
# script writes this onto the stores record, and the app looks the
# record up by LINE_OA_ID. If they don't match character-for-character,
# every store/menu query 404s.
STORE_LINE_OA_ID=@yourbotid
STORE_LINE_CHANNEL_SECRET=
STORE_LINE_CHANNEL_ACCESS_TOKEN=
STORE_LIFF_ID=
STORE_NAME=はるみ鉄板 心斎橋店
STORE_NAME_EN=Harumi Teppan (Shinsaibashi)
STORE_ADDRESS=

# Only read by scripts/debug-store.mjs, for comparing against what's
# actually stored in PocketBase. Not used by the running app.
NEXT_PUBLIC_LINE_OA_ID=@yourbotid
